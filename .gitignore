# Ignore everything at the repo root by default
/*
# Whitelist what we want to track
!/.gitignore
!/Project1_Submission/
!/Project2_Submission/

# Inside the submission folders, drop common cruft
**/__pycache__/
**/*.pyc
**/.DS_Store

# LaTeX byproducts
**/*.aux
**/*.log
**/*.nav
**/*.out
**/*.snm
**/*.toc
**/*.synctex.gz
**/*.fls
**/*.fdb_latexmk

# Editor files
**/*~
**/.idea/
**/.vscode/

# Sweep outputs that are too large for git
# (DDPM checkpoints are tens of MB; results/ mat files are committed)
**/sweep/ddpm_bigger_rot15_ema/
**/sweep/ddpm_cond_rot15_ema/
