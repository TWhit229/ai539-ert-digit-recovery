# Ignore everything at the repo root by default
/*
# Whitelist what we want to track
!/.gitignore
!/Project1_Submission/
!/Project2_Submission/

# Inside the submission folders, drop common cruft
**/__pycache__/
**/*.pyc
**/.DS_Store

# LaTeX byproducts
**/*.aux
**/*.log
**/*.nav
**/*.out
**/*.snm
**/*.toc
**/*.synctex.gz
**/*.fls
**/*.fdb_latexmk

# Editor files
**/*~
**/.idea/
**/.vscode/

# Sweep DDPM checkpoints tracked via Git LFS
